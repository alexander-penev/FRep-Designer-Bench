// dest: benchmark/mpr_bench.cpp
// MPR render benchmark driver: same scenes + resolutions as libfive --render.
// CSV: system,backend,scene,metric,size,ms,throughput,joules,uj_per_unit
// Energy: with MPR_ENERGY_SECS set, each scene renders continuously for that
// many seconds and the row reports marginal GPU energy per frame, measured the
// way libfive's --render-energy and frep4_pathcost measure theirs -- NVML
// counter rather than sampled nvidia-smi power, divided by frames actually
// completed, with a settled idle floor subtracted. Without it the row keeps
// the -1 the suite renders as a dash.
//
// The three properties matter for the same reasons they do elsewhere: NVML
// integrates on a coarse cadence so a handful of millisecond frames samples
// nothing; the card draws around forty watts doing nothing, and charging that
// to whichever renderer is running makes a slow one look expensive for being
// slow; and the floor has to be taken after a pause, or it is measured on a
// card that is still boosted and over-subtracts.
#include <libfive/tree/tree.hpp>
#include <libfive/tree/archive.hpp>
#include <Eigen/Dense>
#include <algorithm>
#include <chrono>
#include <cstdlib>
#include <cstdio>
#include <fstream>
#include <string>
#include <vector>
#include <thread>
#include "tape.hpp"
#include "context.hpp"
#include <dlfcn.h>

// Total GPU energy in joules, or -1 when NVML is unavailable.
//
// Loaded through dlopen rather than linked. The benchmark() macro in mpr's own
// CMakeLists links exactly one library, and teaching it about NVML would mean
// patching upstream build files for a diagnostic -- a patch that breaks the
// next time they move. dlopen keeps the dependency at run time and optional:
// no NVML, no energy column, everything else unchanged.
static double gpu_joules() {
    typedef int (*init_t)();
    typedef int (*handle_t)(unsigned, void**);
    typedef int (*energy_t)(void*, unsigned long long*);
    static bool tried = false, ok = false;
    static void* dev = nullptr;
    static energy_t get_energy = nullptr;
    if (!tried) {
        tried = true;
        void* h = dlopen("libnvidia-ml.so.1", RTLD_LAZY);
        if (!h) h = dlopen("libnvidia-ml.so", RTLD_LAZY);
        if (h) {
            init_t   ini = (init_t)dlsym(h, "nvmlInit_v2");
            handle_t gh  = (handle_t)dlsym(h, "nvmlDeviceGetHandleByIndex_v2");
            get_energy   = (energy_t)dlsym(h, "nvmlDeviceGetTotalEnergyConsumption");
            ok = ini && gh && get_energy && ini() == 0 && gh(0, &dev) == 0;
        }
    }
    if (!ok) return -1;
    unsigned long long mJ = 0;
    if (get_energy(dev, &mJ) != 0) return -1;
    return (double)mJ / 1e3;
}

static std::string base(std::string p) {
    auto s = p.find_last_of('/'); if (s != std::string::npos) p = p.substr(s + 1);
    auto d = p.find_last_of('.');  if (d != std::string::npos) p = p.substr(0, d);
    return p;
}
int main(int argc, char** argv) {
    if (argc < 2) { std::fprintf(stderr, "usage: %s scene.frep [size...]\n", argv[0]); return 1; }
    std::ifstream ifs(argv[1]);
    if (!ifs.is_open()) { std::fprintf(stderr, "open %s failed\n", argv[1]); return 1; }
    libfive::Tree t = libfive::Archive::deserialize(ifs).shapes.front().tree;
    std::string name = base(argv[1]);

    std::vector<int> sizes;
    for (int i = 2; i < argc; ++i) sizes.push_back(std::atoi(argv[i]));
    if (sizes.empty()) sizes = {512, 1024};

    Eigen::Matrix4f T = Eigen::Matrix4f::Identity(); T(3, 2) = 0.3f;
    auto tape = mpr::Tape(t);
    for (int size : sizes) {
        mpr::Context c(size);
        c.render3D(tape, T);                                   // warmup
        // Optional depth dump (MPR_DUMP_PPM=dir): filled[] is the per-pixel
        // surface depth (0 = background), in cudaMallocManaged memory, so it is
        // host-readable after a sync. Lets us confirm mpr renders the SAME
        // geometry as the other systems — mpr exposes no scalar SDF, so this
        // occupancy/depth image is the only cross-system parity handle it has.
        if (const char* dd = std::getenv("MPR_DUMP_PPM")) {
            cudaDeviceSynchronize();
            const uint32_t* nrm = c.normals.get();       // packed normal, 0 = background
            long hit = 0;
            char path[512];
            std::snprintf(path, sizeof path, "%s/%s_mpr_%d.ppm", dd, name.c_str(), size);
            if (FILE* fp = std::fopen(path, "wb")) {
                std::fprintf(fp, "P6\n%d %d\n255\n", size, size);
                for (int i = 0; i < size * size; ++i) {
                    uint32_t v = nrm[i];
                    if (v) { ++hit;
                        std::fputc(v & 0xff, fp); std::fputc((v >> 8) & 0xff, fp);
                        std::fputc((v >> 16) & 0xff, fp); }
                    else { std::fputc(120, fp); std::fputc(150, fp); std::fputc(210, fp); }
                }
                std::fclose(fp);
            }
            std::fprintf(stderr, "mpr %s: %ld/%d surface px (%.1f%%)\n",
                         name.c_str(), hit, size * size, 100.0 * hit / (size * size));
        }
        using clk = std::chrono::steady_clock;
        auto since = [](clk::time_point a) {
            return std::chrono::duration<double>(clk::now() - a).count(); };
        const char* es = std::getenv("MPR_ENERGY_SECS");
        const double esecs = es ? std::atof(es) : 0.0;

        double m = 0, J = -1;
        double px = double(size) * size;
        if (esecs > 0) {
            static double idle_w = -1;
            if (idle_w < 0) {                       // measured once per process
                std::this_thread::sleep_for(std::chrono::seconds(3));  // settle
                double j0 = gpu_joules();
                auto t0 = clk::now();
                while (since(t0) < 3.0)
                    std::this_thread::sleep_for(std::chrono::milliseconds(20));
                double j1 = gpu_joules(), el = since(t0);
                idle_w = (j0 < 0 || j1 < 0 || el <= 0) ? 0.0 : (j1 - j0) / el;
                std::fprintf(stderr, "idle baseline: gpu %.1f W (subtracted)\n", idle_w);
            }
            double j0 = gpu_joules();
            auto t0 = clk::now();
            long frames = 0;
            while (since(t0) < esecs) { c.render3D(tape, T); ++frames; }
            cudaDeviceSynchronize();
            double j1 = gpu_joules(), el = since(t0);
            m = el * 1e3 / (double)frames;
            if (j0 >= 0 && j1 >= 0) {
                double marg = (j1 - j0) - idle_w * el;
                if (marg < 0) marg = 0;             // measured, below the floor
                J = marg / (double)frames;
            }
        } else {
            const int reps = 5;
            std::vector<double> ms;
            for (int r = 0; r < reps; ++r) {
                auto a = clk::now();
                c.render3D(tape, T);
                auto b = clk::now();
                ms.push_back(std::chrono::duration<double, std::milli>(b - a).count());
            }
            std::sort(ms.begin(), ms.end());
            m = ms[reps / 2];
        }
        std::printf("mpr,gpu-cuda,%s,render3d,%d,%.3f,%.3f,%.4f,%.4f\n",
                    name.c_str(), size, m, px / m / 1e3,
                    J, J < 0 ? -1.0 : J * 1e6 / px);
        std::fflush(stdout);
    }
    return 0;
}
